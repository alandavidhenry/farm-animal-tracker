# Database - Azure SQL Server
# Prisma format requires sqlserver:// protocol
DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=your-db-name;user=your-username;password=your-password;encrypt=true;trustServerCertificate=false;connectionTimeout=30"

# Alternative format with @ syntax (may need URL encoding for special chars in password):
# DATABASE_URL="sqlserver://your-username:your-password@your-server.database.windows.net:1433/your-db-name?encrypt=true&trustServerCertificate=false"

# NextAuth
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Azure Storage (for future file uploads)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="animal-files"